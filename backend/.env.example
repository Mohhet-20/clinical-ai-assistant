# Optional: enables LLM extraction/summary/chat, image interpretation and OpenAI embeddings.
# Without it the app runs fully in local "rules mode" (TF-IDF vectors in FAISS, rule-based summary).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=45
EMBEDDINGS=auto

# Live PubMed search (NCBI E-utilities). Set to false to stay fully offline.
PUBMED_LIVE=true
NCBI_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
