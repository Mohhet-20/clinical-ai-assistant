# ---- Deployment profile ------------------------------------------------------------
# development (default) | production. Production refuses to start unless API keys are set.
ENVIRONMENT=development

# ---- Access control ---------------------------------------------------------------
# Comma-separated keys. Clinician keys can analyze/upload/chat/feedback/export FHIR; admin keys
# can additionally read the audit log and /metrics. Leave both empty to disable auth (local dev only).
API_KEYS=
ADMIN_API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# ---- Audit & logging --------------------------------------------------------------
AUDIT_LOG=true
AUDIT_LOG_PATH=
LOG_FORMAT=json
LOG_LEVEL=INFO
DOCS_ENABLED=true
MAX_PDF_PAGES=60

# ---- Optional LLM -----------------------------------------------------------------
# Enables LLM extraction/summary/chat, image interpretation and OpenAI embeddings.
# Without it the app runs fully in local "rules mode" (TF-IDF vectors in FAISS, rule-based summary).
# Text is PHI-redacted before it is sent, but only use a provider covered by a BAA/DPA for real data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=45
EMBEDDINGS=auto

# Live PubMed search (NCBI E-utilities). Set to false to stay fully offline.
PUBMED_LIVE=true
NCBI_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Single sign-on (OIDC) ----------------------------------------------------------
# Recommended for production: per-user identities in the audit trail. OIDC_AUDIENCE is required with OIDC_ISSUER.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_CLINICIAN_ROLE=clarity-clinician
OIDC_ADMIN_ROLE=clarity-admin

# ---- Encrypted case history -----------------------------------------------------------
# Off by default. Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CASE_STORE=false
CASE_ENCRYPTION_KEY=
CASE_RETENTION_DAYS=30
CASE_DB_PATH=
